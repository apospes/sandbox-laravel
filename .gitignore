# --- Secrets / local configuration ---
.env
.env.*
!.env.example

# --- Database backups (may contain data) ---
backups/

# --- Laravel application (inside src/) ---
src/.env
src/.env.*
!src/.env.example
src/vendor/
src/node_modules/
src/public/build/
src/public/hot
src/public/storage
src/storage/*.key
src/storage/pail
src/bootstrap/cache/*.php
src/storage/app/*
!src/storage/app/.gitignore
src/storage/framework/cache/data/*
src/storage/framework/sessions/*
src/storage/framework/testing/*
src/storage/framework/views/*.php
src/storage/logs/*
src/database/*.sqlite
src/database/*.sqlite-journal
src/.phpunit.result.cache
src/.phpunit.cache
src/auth.json

# --- Docker / temporary files ---
*.log
*.tmp
docker-compose.override.yml

# --- IDE / OS ---
.idea/
.vscode/
.fleet/
*.swp
.DS_Store
Thumbs.db
