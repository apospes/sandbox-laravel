# =============================================================================
# Laravel Docker starter - environment template
# ./setup.sh copies this to .env, fills in secrets and keeps your changes on
# re-runs. NEVER commit .env (it is git-ignored). This file is safe to commit.
# =============================================================================

# --- Project identity --------------------------------------------------------
# Lowercase letters, digits, "-" and "_" only. Used to name containers,
# volumes and the network, so every project needs a unique value.
# setup.sh sets this from the directory name on first run.
PROJECT_NAME=laravel-app

# --- Versions ----------------------------------------------------------------
PHP_VERSION=8.3
# Laravel major version used when src/ is empty (e.g. 13, 12, 13.1, latest).
# Laravel 11 is end-of-life: Composer blocks it because of security advisories.
LARAVEL_VERSION=13
# Node.js major version (22 = LTS).
NODE_MAJOR=22
MYSQL_VERSION=8.4
MAILPIT_VERSION=latest

# --- Host ports --------------------------------------------------------------
# Interface the ports are published on. 127.0.0.1 = only this machine.
# Use 0.0.0.0 to expose to your LAN (be careful: dev services, weak defaults).
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
MYSQL_PORT=3307
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
VITE_PORT=5173

# --- Container user ----------------------------------------------------------
# Set automatically by setup.sh to your host user so file ownership matches.
HOST_UID=1000
HOST_GID=1000
TZ=UTC

# --- Xdebug ------------------------------------------------------------------
# XDEBUG_MODE: off (default, no overhead) | debug | debug,develop | coverage | profile
# Toggle with: make xdebug-on / make xdebug-off
XDEBUG_MODE=off
XDEBUG_PORT=9003
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_IDEKEY=PHPSTORM

# --- Database (MySQL) --------------------------------------------------------
# Leave the passwords empty: setup.sh generates random ones.
# These initialise the MySQL container and are copied into src/.env for Laravel.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Mail (Mailpit) ----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
